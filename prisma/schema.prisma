generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  plan          Plan      @default(FREE)
  accounts      Account[]
  sessions      Session[]
  scans         Scan[]
  createdAt     DateTime  @default(now())
}

enum Plan {
  FREE
  PAID
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Scan {
  id        String     @id @default(cuid())
  url       String
  userId    String?
  status    ScanStatus @default(PENDING)
  rawResult Json?
  aiReport  String?
  createdAt DateTime   @default(now())
  user      User?      @relation(fields: [userId], references: [id])
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
}
